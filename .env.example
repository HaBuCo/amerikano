# Public client values from Supabase Dashboard > Connect > Expo React Native.
# These are bundled into the app; database security must be enforced with RLS.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Google Sign-In: OAuth 2.0 Client IDs from Google Cloud Console
# (console.cloud.google.com > APIs & Services > Credentials).
# webClientId must be a "Web application" client and is also entered as the
# Google provider's Client ID in Supabase Dashboard > Authentication > Providers.
# iosClientId is an "iOS" client; its reversed form goes into app.json's
# @react-native-google-signin/google-signin plugin `iosUrlScheme`.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=REPLACE_WITH_IOS_CLIENT_ID.apps.googleusercontent.com
